# ---------- Backend (FastAPI) ----------
# Used when running uvicorn directly; docker-compose overrides the host to "db".
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobs
# Required for POST /api/jobs (sent as X-API-Key). Generate: openssl rand -hex 32
API_SECRET_KEY=change-me
# Redis for response caching (unset = per-process in-memory cache)
REDIS_URL=redis://localhost:6379/0
# Comma-separated browser origins allowed by CORS (your production Vercel domain)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# docker-compose Postgres (optional overrides)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jobs

# ---------- Frontend (Next.js, put in frontend/.env.local or Vercel env) ----------
# Server-side fetches and the /api/jobs/[id] proxy (what the current code reads)
API_URL=http://localhost:8000
# Only needed if the browser calls the API directly (this is what makes CORS matter)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Scrapers / GitHub Actions secrets ----------
BACKEND_API_URL=http://localhost:8000
